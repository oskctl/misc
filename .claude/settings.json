{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/inject-claude-md.sh",
            "statusMessage": "Injecting CLAUDE.md..."
          },
          {
            "type": "command",
            "command": ".claude/hooks/reset-loop-count.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-response-loop.sh",
            "statusMessage": "Loop pass..."
          }
        ]
      }
    ]
  }
}
